{
  "name": "daykey-lesson-jump",
  "displayName": "DayKey Lesson Jump",
  "description": "Navigate DayKey lesson comments across all files.",
  "version": "0.0.8",
  "publisher": "local",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "daykey.nextLesson",
        "title": "DayKey: Next Lesson",
        "category": "DayKey"
      },
      {
        "command": "daykey.previousLesson",
        "title": "DayKey: Previous Lesson",
        "category": "DayKey"
      }
    ],
    "keybindings": [
      {
        "key": "alt+n",
        "command": "daykey.nextLesson",
        "when": "editorTextFocus && daykey.lessonNavigationEnabled"
      },
      {
        "key": "alt+p",
        "command": "daykey.previousLesson",
        "when": "editorTextFocus && daykey.lessonNavigationEnabled"
      },
      {
        "key": "cmd+alt+n",
        "command": "daykey.nextLesson",
        "when": "editorTextFocus && daykey.lessonNavigationEnabled"
      },
      {
        "key": "cmd+alt+p",
        "command": "daykey.previousLesson",
        "when": "editorTextFocus && daykey.lessonNavigationEnabled"
      }
    ]
  }
}
